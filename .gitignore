# --- Rust ---
/target/
debug/
**/*.rs.bk
*.pdb
# Cargo.lock is intentionally committed (this crate builds a binary)

# Generated by cargo mutants
**/mutants.out*/

# --- Environment / secrets ---
.env
.env.*
*.env
secrets/
secrets.*
credentials/
credentials.*
.credentials/

# Private keys / certificates
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
*.der
*.crt
id_rsa
id_ed25519
id_ecdsa
*.ppk

# Local MCP config (contains an API token; keep it out of version control)
.mcp.json

# --- Claude Code local overrides ---
.claude/settings.local.json

# --- IDE / editor ---
.idea/
*.iml
.vscode/
*.code-workspace
*.swp
*.swo
*~

